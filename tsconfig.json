{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noEmit": true, "allowImportingTsExtensions": true,
    "esModuleInterop": true, "skipLibCheck": true, "resolveJsonModule": true,
    "types": ["node", "vite/client"], "lib": ["ES2022", "DOM"]
  },
  "include": ["packages/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"],
  "exclude": ["**/node_modules", "**/dist"]
}
