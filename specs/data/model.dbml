// Core tables implemented in packages/server/prisma, 2026-10-21.
// Permissions uses the single-rule policy and reviewed semantic overrides; legacy live JSON is converted at startup.
// Physical columns and SQL constraints are unchanged; policy conversion and JSON references are application-enforced.
// Product rules: ../features/permissions.md, ../features/decisions.md and other feature specs.
// Transactions, JSON contracts and SQL-only constraints: ../../docs/data-model.md
Project ash {
  database_type: 'PostgreSQL'
  Note: 'Core state, Permissions and Decisions. Recovery uses physical backups and archived WAL; Thread application history is stored separately from Artifacts.'
}

Table topics {
  id uuid [pk, not null]
  name text [not null]
  instruction_id uuid [unique, note: 'This Topic owns the Instruction; null if none. Ownership is checked across Topics and Threads.']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  deleted_at timestamptz [note: 'Null while active; set on soft deletion.']

  Note: 'Soft deletion removes memberships but retains the Instruction and Threads.'
}

Table threads {
  id uuid [pk, not null]
  title text [not null]
  instruction_id uuid [unique, note: 'This Thread owns the Instruction; null if none. Ownership is checked across Topics and Threads.']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
  is_archived boolean [not null, default: false, note: 'Hidden from the ordinary thread list; accessible in the archive.']
  is_pinned boolean [not null, default: false, note: 'Pinned in the thread list. Does not override is_archived.']
  interaction_mode text [not null, default: 'chat', check: `interaction_mode IN ('chat','adapt')`, note: 'Routes future submissions; accepted Runs retain their captured mode.']
  initial_title text [note: 'Creation identity, independent of subsequent naming.']
  lifecycle jsonb [not null, default: `'{}'::jsonb`, note: 'Validated ThreadLifecycle checkpoint; see visibility implementation.']
  topics_version integer [not null, default: 0, check: `topics_version >= 0`, note: 'Rejects stale membership edits without changing thread activity.']

  Note: 'Normal threads; Topic membership is optional.'
}

Table thread_topics {
  thread_id uuid [not null]
  topic_id uuid [not null]
  linked_at timestamptz [not null]

  indexes {
    (thread_id, topic_id) [pk]
    topic_id
  }
  Note: 'Current Thread/Topic membership.'
}

Table artifacts {
  id uuid [pk, not null, note: 'Stable across streaming and moves.']
  layer text [not null, check: `layer IN ('input', 'filter', 'route', 'act', 'surface')`, note: 'Engine stage that produced the Artifact.']
  source_id uuid [note: 'Immediate source; null for Input roots, required otherwise. Immutable.']
  thread_id uuid [note: 'Surface: required current owner. Other layers: original processing association, or null if unknown.']
  run_id uuid [note: 'Producing Run; null for user Input/Surface and pre-Act processing.']
  actor text [not null, check: `actor IN ('user', 'ash', 'system')`, note: 'Attribution: user input/messages, Ash actions/replies, or system ingestion.']
  payload jsonb [not null, note: 'Validated content with a type tag. Surface: speaker/content. Model request: messages/provider/model/options. Model-routing preparation retains frozen context and assessment input. Act type: permission_evaluation, containing action, rule snapshots, evidence and outcome. Only active response content may grow.']
  created_at timestamptz [not null, note: 'When first saved; immutable. Used with id for thread ordering.']
  updated_at timestamptz [not null, note: 'When content or thread ownership last changed; initially created_at.']

  indexes {
    source_id
    run_id
    (thread_id, created_at, id)
  }
  checks {
    `(layer = 'input' AND source_id IS NULL) OR (layer <> 'input' AND source_id IS NOT NULL)`
    `source_id IS NULL OR source_id <> id`
    `layer <> 'surface' OR thread_id IS NOT NULL`
  }
  Note: 'The Artifact Log. Payload contracts: docs/data-model.md#artifact-payloads.'
}

Table instructions {
  id uuid [pk, not null]
  key text [unique, note: 'Global prompt key, e.g. response; null for Topic/Thread instructions.']
  name text [not null]
  text text [not null]
  created_at timestamptz [not null]
  updated_at timestamptz [not null]

  Note: 'One document per Topic, Thread or global prompt. Ownership checks: docs/data-model.md#instructions-and-captured-requests.'
}

Table runs {
  id uuid [pk, not null, note: 'New for each execution, including explicit retries.']
  input_artifact_id uuid [not null, note: 'Input that triggered the Run; reused by retries.']
  thread_id uuid [note: 'Thread target; null for standalone image description Runs. Unchanged by Surface moves.']
  retry_of_id uuid [note: 'Previous settled Run for an explicit retry; null for the initial execution.']
  status text [not null, check: `status IN ('queued', 'running', 'waiting', 'completed', 'failed', 'cancelled', 'interrupted')`, note: 'Current execution state; starts queued. Waiting is nonterminal and releases the Thread execution slot.']
  state jsonb [not null, note: 'Latest workflow checkpoint. Decision dependencies by ID, per-step consumption and action/attempt progress. JSON references are application-validated, not foreign keys. Contracts: docs/data-model.md and docs/features/decisions.md.']
  error jsonb [note: 'Failure code, message and optional details; null when no failure is recorded.']
  request_key uuid [unique, not null, note: 'Used to prevent duplicate run submissions. Reuse on delivery retry; replace on execution retry.']
  request_hash text [not null, note: 'Detects reuse of request_key with different command content or target.']
  created_at timestamptz [not null, note: 'When accepted and saved; immutable.']
  started_at timestamptz [note: 'When execution starts; null while queued or if stopped before starting.']
  ended_at timestamptz [note: 'Null while queued/running or in the waiting state; set when settled.']

  indexes {
    input_artifact_id
    thread_id
    retry_of_id
  }
  checks {
    `retry_of_id IS NULL OR retry_of_id <> id`
    `(status IN ('queued', 'running', 'waiting') AND ended_at IS NULL) OR (status IN ('completed', 'failed', 'cancelled', 'interrupted') AND ended_at IS NOT NULL)`
    `status NOT IN ('running', 'waiting', 'completed') OR started_at IS NOT NULL`
    `jsonb_typeof(state) = 'object'`
    `error IS NULL OR jsonb_typeof(error) = 'object'`
  }
  Note: 'Act workflow. Queued/running execution is serialized per Thread; waiting releases that slot. Eligible steps resume from saved progress after current checks. Dependencies remain in state; no run_decisions table.'
}

Ref: instructions.id - topics.instruction_id [delete: restrict]
Ref: instructions.id - threads.instruction_id [delete: restrict]
Ref: thread_topics.thread_id > threads.id [delete: restrict]
Ref: thread_topics.topic_id > topics.id [delete: restrict]
Ref: artifacts.source_id > artifacts.id [delete: restrict]
Ref: artifacts.thread_id > threads.id [delete: restrict]
Ref: artifacts.run_id > runs.id [delete: restrict]
Ref: runs.input_artifact_id > artifacts.id [delete: restrict]
Ref: runs.thread_id > threads.id [delete: restrict]
Ref: runs.retry_of_id > runs.id [delete: restrict]

Table attachments {
  id uuid [pk, not null]
  filename text [not null]
  input_artifact_id uuid [unique, not null, note: 'Upload Input root.']
  summary_run_id uuid [unique, note: 'Latest image description attempt.']
  summary text [note: 'Latest completed description; request snapshots preserve their own text.']
  metadata jsonb [not null, note: 'Immutable original/model/thumbnail hashes, media types, byte sizes, dimensions and transform version.']
  created_at timestamptz [not null]
  expires_at timestamptz [note: 'Unsubmitted upload expiry; null after a message retains this image.']
  indexes { expires_at }
}

Table artifact_attachments {
  artifact_id uuid [not null]
  attachment_id uuid [not null]
  indexes {
    (artifact_id, attachment_id) [pk]
    attachment_id
  }
  Note: 'Enforced lifecycle references from upload, message, description and captured-request Artifacts.'
}

Ref: attachments.input_artifact_id > artifacts.id [delete: restrict]
Ref: attachments.summary_run_id > runs.id [delete: restrict]
Ref: artifact_attachments.artifact_id > artifacts.id [delete: restrict]
Ref: artifact_attachments.attachment_id > attachments.id [delete: restrict]
Table provider_continuations {
  output_artifact_id uuid [pk, not null]
  run_id uuid [not null]
  items jsonb [not null, note: 'Private provider replay items; excluded from inspection APIs']
  created_at timestamptz(6) [not null]
  indexes { run_id }
}
Ref: provider_continuations.output_artifact_id > artifacts.id [delete: restrict]
Ref: provider_continuations.run_id > runs.id [delete: restrict]

Table incoming_items {
 id uuid [pk, not null, note: 'Same identity as the retained Input; immutable.']
 source_key text [unique, not null, note: 'Hash of source namespace/event identity; immutable delivery deduplication key.']
 request_hash text [not null, note: 'Original content and explicit-target hash; rejects conflicting delivery.']
 status text [not null, note: 'Intake lifecycle: queued, processing, waiting_capacity, completed, dropped, failed or interrupted.']
 state jsonb [not null, note: 'Current stage and immutable Artifact references, target and eventual Run. Updated transactionally with progress.']
 error text [note: 'Safe current failure summary; null without a failure. Earlier failures remain Artifacts.']
 created_at timestamptz(6) [not null, note: 'Receipt time; immutable.']
 updated_at timestamptz(6) [not null, note: 'Latest checkpoint change.']
 indexes { (status, created_at) }
}
Ref: incoming_items.id > artifacts.id [delete: restrict]

// Permissions and Decisions: docs/features/permissions.md and docs/features/decisions.md.
Table permissions {
  id uuid [pk, not null, note: 'Stable permission identity; immutable.']
  category text [not null, check: `category IN ('filesystem', 'computer_use', 'interaction', 'self_modification')`, note: 'Fixed UI category assigned on creation; excluded from evaluation and permission selection.']
  effect text [not null, check: `effect IN ('allow', 'ask', 'deny')`, note: 'Editable policy effect; Never in the UI means deny, not deletion.']
  policy jsonb [not null, check: `jsonb_typeof(policy) = 'object'`, note: 'Exactly one permission. kind explicit stores verb and one typed resource matcher; kind semantic stores complete accepted condition, optional examples and overrides (UUIDs of reviewed overridden Permissions; priority applies only to shared actions/targets and does not assert containment). Names derive from verb/resource or condition; no separate name, wording copy, original text, resource/activity flag or permission versions. JSON reference validity and review are application-enforced. Contract: docs/features/permissions.md#permissions.']
  created_at timestamptz [not null, note: 'When created; immutable.']
  updated_at timestamptz [not null, note: 'Initially created_at; changes with a saved edit or retirement.']
  deleted_at timestamptz [note: 'Null while active; set when a permission is retired. Earlier evaluations preserve their permission snapshots.']

  indexes {
    (category, deleted_at)
  }
  Note: 'Standing policy only. Semantic override links stay in policy JSON; no relationship table or SQL FK for those references. Review scope/effect changes and clean incoming references on retirement. One-time exceptions/approvals stay on Decisions; evaluated permission and override snapshots use Act Artifacts. Connection capabilities and mappings belong to future connection records.'
}

Table decisions {
  id uuid [pk, not null, note: 'Stable identity allocated before creation and reused on delivery retries. Conflicting reuse is rejected. Independent of Thread or Run; immutable.']
  thread_id uuid [note: 'Optional primary Thread association; null for standalone Decisions. Other views reference this same record.']
  source_artifact_id uuid [note: 'Originating Artifact; null for requests without one. Preserve the original source.']
  status text [not null, default: 'pending', check: `status IN ('pending', 'snoozed', 'resolved', 'cancelled')`, note: 'Request lifecycle, separate from execution. Resolved and cancelled are terminal; answered Decisions never reopen.']
  request jsonb [not null, check: `jsonb_typeof(request) = 'object'`, note: 'Immutable typed question, context and response definition. Permission requests include action binding, scope, findings and any explicit deny exceptions. Material changes cancel an unanswered request with a reason; create an independent Decision only if input is still needed.']
  resolution jsonb [note: 'Single immutable terminal result: answer with submissionId, value, optional comment, trusted source/sourceArtifactId and resolvedAt; or cancellation with reason and resolvedAt. Null while pending or snoozed. Permission approval requires explicit controls. JSON references are application-validated.']
  snoozed_until timestamptz [note: 'Set while snoozed; clear on wake, response or cancellation. Changes attention only.']
  due_at timestamptz [note: 'Optional substantive request deadline, set from reviewed terms; not an automatic approval expiry. Material changes follow the changed-request rule.']
  created_at timestamptz [not null, note: 'When created; immutable.']
  updated_at timestamptz [not null, note: 'Initially created_at; changes with lifecycle transitions, including the single resolution.']

  indexes {
    (status, created_at, id)
    (status, snoozed_until)
    (status, due_at)
    thread_id
    source_artifact_id
  }
  checks {
    `(status = 'snoozed' AND snoozed_until IS NOT NULL) OR (status <> 'snoozed' AND snoozed_until IS NULL)`
    `(status IN ('pending', 'snoozed') AND resolution IS NULL) OR (status IN ('resolved', 'cancelled') AND resolution IS NOT NULL)`
    `resolution IS NULL OR jsonb_typeof(resolution) = 'object'`
  }
  Note: 'Reviewed request and immutable resolution share one record. Dependencies, consumption and work cancellation live in runs.state. No answer versions, withdrawal records or permission_authorizations table. Payload shapes are application-validated; SQL protects request/resolution immutability.'
}

Ref: decisions.thread_id > threads.id [delete: restrict]
Ref: decisions.source_artifact_id > artifacts.id [delete: restrict]

Table thread_assessments {
  id uuid [pk, not null]
  thread_id uuid [not null]
  kind text [not null]
  status text [not null]
  capture jsonb [not null, note: 'Immutable activity/control/context revisions and trigger references.']
  request jsonb [not null, note: 'Exact model request saved before dispatch; immutable.']
  result jsonb [note: 'Null while running; one terminal outcome, public output and provider metadata, then immutable.']
  created_at timestamptz [not null]
  finished_at timestamptz
  indexes {
    (thread_id, created_at)
  }
  Note: 'One running assessment per Thread and kind (partial unique SQL index). Captures are immutable; one terminal update stores the result/status/time. No Artifact is created.'
}
Ref: thread_assessments.thread_id > threads.id [delete: restrict, update: no action]

Table application_changes {
 id uuid [pk, not null, note: 'Manual command identity or generated automatic change identity; immutable.']
 thread_id uuid [not null, note: 'Affected Thread; immutable.']
 origin text [not null, note: 'manual, automatic, activity or undo; immutable.']
 command jsonb [note: 'Accepted manual command; null for automatic changes. Immutable.']
 events jsonb [not null, note: 'Actual archive, title, pin and naming-mode transitions; empty for commands with no transition. Immutable.']
 source_artifact_id uuid [note: 'Existing meaningful activity causing revival; null for manual or assessed changes. Read-only provenance.']
 assessment_id uuid [note: 'Applied assessment causing the change; otherwise null.']
 created_at timestamptz(6) [not null, note: 'Time accepted/applied; immutable.']
 indexes {
  (thread_id, created_at, id)
  source_artifact_id
  assessment_id
 }
 Note: 'Application history, separate from Artifact chains. Never dispatches work or enters ordinary response context by itself.'
}
Ref: application_changes.thread_id > threads.id [delete: restrict, update: no action]
Ref: application_changes.source_artifact_id > artifacts.id [delete: restrict, update: no action]
Ref: application_changes.assessment_id > thread_assessments.id [delete: restrict, update: no action]

Table adapt_workspaces {
  id uuid [pk, not null]
  thread_id uuid [not null, unique, note: 'One Workspace per Thread in the first phase.']
  base_revision text [not null, note: 'Exact configured master commit; immutable source base.']
  status text [not null, default: 'preparing']
  controller jsonb [not null, default: `'{}'::jsonb`, note: 'Private versioned provider binding and environment generation; excluded from public views.']
  checkpoint jsonb [note: 'Last validated source patch/tree and reported checks; null before first export.']
  created_at timestamptz [not null]
  updated_at timestamptz [not null]
}
Table adapt_executions {
  run_id uuid [pk, not null, note: 'Ash Run; captured context is an immutable coding_request Artifact.']
  workspace_id uuid [not null]
  controller jsonb [not null, default: `'{}'::jsonb`, note: 'Private dispatch journal, session identity and cancellation/cleanup state.']
  indexes { workspace_id }
}
Ref: adapt_workspaces.thread_id > threads.id [delete: restrict, update: no action]
Ref: adapt_executions.run_id > runs.id [delete: restrict, update: no action]
Ref: adapt_executions.workspace_id > adapt_workspaces.id [delete: restrict, update: no action]
Table scene_bundles {
 id text [pk, not null, note: 'Immutable bundle identity; versioned independently of Threads.']
 manifest jsonb [not null, note: 'Immutable validated asset hashes, profile, framing, provenance and verification metadata.']
 manifest_text text [not null, note: 'Canonical exact serialized manifest used for hashes and reads; avoids JSON transport precision loss. JSONB is its query projection.']
 manifest_hash text [not null, note: 'SHA-256 of the serialized immutable manifest; checked before playback or activation.']
 size_bytes integer [not null, note: 'Total immutable file bytes; positive and checked against storage limits.']
 created_at timestamptz(6) [not null, note: 'Publication time; immutable.']
}
Table scene_state {
 id text [pk, not null, note: 'Instance scene state key; currently default.']
 active_bundle_id text [note: 'Current approved bundle; null until initialized. Changed atomically with previous and revision.']
 previous_bundle_id text [note: 'Previous approved bundle retained for fallback; null without a predecessor.']
 location jsonb [note: 'Saved city, coordinates and timezone. Null uses the San Francisco default.']
 revision integer [not null, default: 0, note: 'Monotonic compare-and-swap revision for scene activation and saved location changes.']
 updated_at timestamptz(6) [not null, note: 'Latest scene state or location change.']
}
Ref: scene_state.active_bundle_id > scene_bundles.id [delete: restrict, update: no action]
Ref: scene_state.previous_bundle_id > scene_bundles.id [delete: restrict, update: no action]
